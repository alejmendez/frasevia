# ---------------------------------------------------------------------------
# Frasevia — variables de entorno
#
# Copia este archivo a `.env` y completa los valores de tu proyecto Supabase.
# NO subas `.env` al control de versiones (ya está en .gitignore).
# ---------------------------------------------------------------------------

# URL del proyecto Supabase (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Clave publicable / anon del proyecto.
# NUNCA uses la `service_role` ni ninguna clave secreta: son para el servidor.
# Supabase → Settings → API → Project Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=
